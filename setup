#!/bin/bash

# Bluna AI Cross-Platform Setup Script
# Supports Linux, macOS, and Windows (via WSL/Git Bash)

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Detect OS
detect_os() {
    if [[ "$OSTYPE" == "linux-gnu"* ]]; then
        echo "linux"
    elif [[ "$OSTYPE" == "darwin"* ]]; then
        echo "macos"
    elif [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" ]]; then
        echo "windows"
    else
        echo "unknown"
    fi
}

# Detect package manager
detect_package_manager() {
    local os=$1
    case $os in
        "linux")
            if command -v apt &> /dev/null; then
                echo "apt"
            elif command -v yum &> /dev/null; then
                echo "yum"
            elif command -v dnf &> /dev/null; then
                echo "dnf"
            elif command -v pacman &> /dev/null; then
                echo "pacman"
            elif command -v zypper &> /dev/null; then
                echo "zypper"
            else
                echo "none"
            fi
            ;;
        "macos")
            echo "brew"
            ;;
        "windows")
            echo "choco"
            ;;
    esac
}

# Install Julia
install_julia() {
    local os=$1
    local pkg_manager=$2
    
    print_status "Checking Julia installation..."
    
    if command -v julia &> /dev/null; then
        julia_version=$(julia --version | cut -d' ' -f3)
        print_success "Julia is already installed (version $julia_version)"
        return 0
    fi
    
    print_status "Installing Julia..."
    
    case $os in
        "linux")
            case $pkg_manager in
                "apt")
                    sudo apt update
                    sudo apt install -y julia
                    ;;
                "yum")
                    sudo yum install -y julia
                    ;;
                "dnf")
                    sudo dnf install -y julia
                    ;;
                "pacman")
                    sudo pacman -S --noconfirm julia
                    ;;
                "zypper")
                    sudo zypper install -y julia
                    ;;
                *)
                    print_warning "Package manager not supported. Installing Julia manually..."
                    install_julia_manual
                    ;;
            esac
            ;;
        "macos")
            if ! command -v brew &> /dev/null; then
                print_status "Installing Homebrew..."
                /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
            fi
            brew install julia
            ;;
        "windows")
            if command -v choco &> /dev/null; then
                choco install julia
            else
                print_warning "Please install Julia manually from https://julialang.org/downloads/"
                return 1
            fi
            ;;
    esac
    
    # Verify installation
    if command -v julia &> /dev/null; then
        julia_version=$(julia --version | cut -d' ' -f3)
        print_success "Julia installed successfully (version $julia_version)"
    else
        print_error "Julia installation failed"
        return 1
    fi
}

# Install Julia manually (fallback)
install_julia_manual() {
    local temp_dir=$(mktemp -d)
    cd "$temp_dir"
    
    print_status "Downloading Julia..."
    if [[ $(uname -m) == "x86_64" ]]; then
        julia_tar="julia-1.9.4-linux-x86_64.tar.gz"
    elif [[ $(uname -m) == "aarch64" ]]; then
        julia_tar="julia-1.9.4-linux-aarch64.tar.gz"
    else
        print_error "Unsupported architecture: $(uname -m)"
        return 1
    fi
    
    curl -L -o "$julia_tar" "https://julialang-s3.julialang.org/bin/linux/x64/1.9/$julia_tar"
    
    print_status "Extracting Julia..."
    tar -xzf "$julia_tar"
    
    print_status "Installing Julia to /usr/local/bin..."
    sudo mv julia-*/ /opt/julia
    sudo ln -sf /opt/julia/bin/julia /usr/local/bin/julia
    
    # Clean up
    cd /
    rm -rf "$temp_dir"
    
    print_success "Julia installed manually to /opt/julia"
}

# Install Ollama
install_ollama() {
    local os=$1
    
    print_status "Checking Ollama installation..."
    
    if command -v ollama &> /dev/null; then
        print_success "Ollama is already installed"
        return 0
    fi
    
    print_status "Installing Ollama..."
    
    case $os in
        "linux")
            curl -fsSL https://ollama.ai/install.sh | sh
            ;;
        "macos")
            if ! command -v brew &> /dev/null; then
                print_status "Installing Homebrew..."
                /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
            fi
            brew install ollama
            ;;
        "windows")
            print_warning "Please install Ollama manually from https://ollama.ai/download"
            return 1
            ;;
    esac
    
    # Verify installation
    if command -v ollama &> /dev/null; then
        print_success "Ollama installed successfully"
    else
        print_error "Ollama installation failed"
        return 1
    fi
}

# Install Julia packages
install_julia_packages() {
    print_status "Installing Julia packages..."
    
    # Create a temporary script to install packages
    local temp_script=$(mktemp)
    cat > "$temp_script" << 'EOF'
using Pkg
Pkg.add("HTTP")
Pkg.add("JSON") 
Pkg.add("Crayons")
Pkg.add("FIGlet")
Pkg.add("Cascadia")
Pkg.add("Gumbo")
Pkg.add("Printf")
Pkg.add("URIs")
Pkg.add("Dates")
Pkg.add("Markdown")
EOF
    
    # Run the installation script
    julia "$temp_script"
    
    # Clean up
    rm "$temp_script"
    
    print_success "Julia packages installed successfully"
}

# Install additional system dependencies
install_system_deps() {
    local os=$1
    local pkg_manager=$2
    
    print_status "Installing system dependencies..."
    
    case $os in
        "linux")
            case $pkg_manager in
                "apt")
                    sudo apt update
                    sudo apt install -y curl wget git build-essential
                    ;;
                "yum")
                    sudo yum install -y curl wget git gcc gcc-c++ make
                    ;;
                "dnf")
                    sudo dnf install -y curl wget git gcc gcc-c++ make
                    ;;
                "pacman")
                    sudo pacman -S --noconfirm curl wget git base-devel
                    ;;
                "zypper")
                    sudo zypper install -y curl wget git gcc gcc-c++ make
                    ;;
            esac
            ;;
        "macos")
            if ! command -v brew &> /dev/null; then
                print_status "Installing Homebrew..."
                /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
            fi
            brew install curl wget git
            ;;
        "windows")
            print_warning "Please ensure you have Git and build tools installed"
            ;;
    esac
}

# Create desktop shortcut (Linux/macOS)
create_desktop_shortcut() {
    local os=$1
    local install_dir=$2
    
    case $os in
        "linux")
            local desktop_dir="$HOME/Desktop"
            local shortcut_file="$desktop_dir/Bluna-AI.desktop"
            
            cat > "$shortcut_file" << EOL
[Desktop Entry]
Name=Bluna AI
Comment=AI Programming Assistant
Exec=julia "$install_dir/main.jl"
Terminal=true
Type=Application
Categories=Development;
Icon=$install_dir/../images/Bluna-AI.png
Path=$install_dir
EOL
            
            chmod +x "$shortcut_file"
            print_success "Desktop shortcut created: $shortcut_file"
            ;;
        "macos")
            local applications_dir="$HOME/Applications"
            mkdir -p "$applications_dir"
            local app_bundle="$applications_dir/Bluna AI.app"
            
            # Create a simple shell script wrapper
            cat > "$app_bundle/Contents/MacOS/bluna-ai" << EOL
#!/bin/bash
cd "$install_dir"
julia main.jl
EOL
            
            chmod +x "$app_bundle/Contents/MacOS/bluna-ai"
            print_success "Application bundle created: $app_bundle"
            ;;
    esac
}

# Main installation function
main() {
    local os=$(detect_os)
    local pkg_manager=$(detect_package_manager "$os")
    
    print_status "Bluna AI Setup - Cross-Platform Installer"
    print_status "Detected OS: $os"
    print_status "Detected Package Manager: $pkg_manager"
    echo
    
    # Get installation directory
    local install_dir="$HOME/.bluna-ai"
    if [[ $# -gt 0 ]]; then
        install_dir="$1"
    fi
    
    print_status "Installation directory: $install_dir"
    echo
    
    # Check if running as root (not recommended)
    if [[ $EUID -eq 0 ]]; then
        print_warning "Running as root is not recommended"
        read -p "Continue anyway? (y/N): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            print_error "Installation cancelled"
            exit 1
        fi
    fi
    
    # Create installation directory
    print_status "Creating installation directory..."
    mkdir -p "$install_dir"
    
    # Copy project files
    print_status "Copying project files..."
    cp -r ./* "$install_dir/"
    
    # Install system dependencies
    install_system_deps "$os" "$pkg_manager"
    
    # Install Julia
    if ! install_julia "$os" "$pkg_manager"; then
        print_error "Failed to install Julia"
        exit 1
    fi
    
    # Install Ollama
    if ! install_ollama "$os"; then
        print_warning "Failed to install Ollama (you can install it manually later)"
    fi
    
    # Install Julia packages
    cd "$install_dir"
    install_julia_packages
    
    # Pull recommended Ollama model
    if command -v ollama &> /dev/null; then
        print_status "Pulling recommended Ollama model (this may take a while)..."
        ollama pull qwen2.5-coder:0.5b || print_warning "Failed to pull Ollama model"
    fi
    
    # Create desktop shortcut
    create_desktop_shortcut "$os" "$install_dir"
    
    # Run initial setup
    print_status "Running initial setup..."
    julia main.jl --setup
    
    print_success "Bluna AI installed successfully!"
    echo
    print_status "To start Bluna AI, run:"
    echo "  julia $install_dir/main.jl"
    echo
    if [[ "$os" != "windows" ]]; then
        print_status "Or use the desktop shortcut that was created"
    fi
    echo
    print_status "Enjoy learning with Bluna AI! 🌙💙"
}

# Run main function with all arguments
main "$@"
